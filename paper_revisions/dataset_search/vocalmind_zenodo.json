{"created": "2025-01-20T08:29:04.105567+00:00", "modified": "2025-02-22T13:57:12.824730+00:00", "id": 14696348, "conceptrecid": "14049894", "doi": "10.5281/zenodo.14696348", "conceptdoi": "10.5281/zenodo.14049894", "doi_url": "https://doi.org/10.5281/zenodo.14696348", "metadata": {"title": "VocalMind: A Stereotactic EEG Dataset for Vocalized, Mimed, and Imagined Speech in Tonal Language", "doi": "10.5281/zenodo.14696348", "publication_date": "2025-01-20", "description": "<p>&nbsp;Speech BCIs based on implanted electrodes hold significant promise for enhancing spoken communication through high temporal resolution and invasive neural sensing. Despite the potential, acquiring such data is challenging due to its invasive nature, and publicly available datasets, particularly for tonal languages, are limited. In this study, we introduce <em>VocalMind</em>, a stereotactic electroencephalography (sEEG) dataset focused on Mandarin Chinese, a tonal language. This dataset includes sEEG-speech parallel recordings from three distinct speech modes, namely vocalized speech, mimed speech, and imagined speech, at both word and sentence levels, totaling over one hour of intracranial neural recordings related to speech production. This paper also presents a baseline model as the reference model for future studies, at the same time, ensuring the integrity of the dataset. The diversity of tasks and the substantial data volume provide a valuable resource for developing advanced algorithms for speech decoding, thereby advancing BCI research for spoken communication.</p>", "access_right": "open", "creators": [{"name": "He, Tianyu", "affiliation": "Chinese University of Hong Kong, Shenzhen"}, {"name": "Wei, Mingyi", "affiliation": "Shenzhen University"}, {"name": "Wang, Ruicong", "affiliation": "Chinese University of Hong Kong, Shenzhen"}, {"name": "Wang, Renzi", "affiliation": "Chinese University of Hong Kong, Shenzhen"}, {"name": "Du, Shiwei", "affiliation": "Shenzhen University"}, {"name": "Cai, Siqi", "affiliation": "Chinese University of Hong Kong, Shenzhen"}, {"name": "Tao, Wei", "affiliation": "Shenzhen University"}, {"name": "Li, Haizhou", "affiliation": "Chinese University of Hongkong, Shenzhen"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "14049894"}}]}}, "title": "VocalMind: A Stereotactic EEG Dataset for Vocalized, Mimed, and Imagined Speech in Tonal Language", "links": {"self": "https://zenodo.org/api/records/14696348", "self_html": "https://zenodo.org/records/14696348", "preview_html": "https://zenodo.org/records/14696348?preview=1", "doi": "https://doi.org/10.5281/zenodo.14696348", "self_doi": "https://doi.org/10.5281/zenodo.14696348", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.14696348", "reserve_doi": "https://zenodo.org/api/records/14696348/draft/pids/doi", "parent": "https://zenodo.org/api/records/14049894", "parent_html": "https://zenodo.org/records/14049894", "parent_doi": "https://doi.org/10.5281/zenodo.14049894", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.14049894", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:14696348/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:14696348/sequence/default", "files": "https://zenodo.org/api/records/14696348/files", "media_files": "https://zenodo.org/api/records/14696348/media-files", "archive": "https://zenodo.org/api/records/14696348/files-archive", "archive_media": "https://zenodo.org/api/records/14696348/media-files-archive", "latest": "https://zenodo.org/api/records/14696348/versions/latest", "latest_html": "https://zenodo.org/records/14696348/latest", "versions": "https://zenodo.org/api/records/14696348/versions", "draft": "https://zenodo.org/api/records/14696348/draft", "access_links": "https://zenodo.org/api/records/14696348/access/links", "access_grants": "https://zenodo.org/api